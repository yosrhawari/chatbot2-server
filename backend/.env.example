# =============================================================================
# Vilavi Chatbot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All settings have sensible defaults; no required vars when using local Ollama.
# =============================================================================

# --- LLM Provider ---
# For local Ollama (default — set OLLAMA_MODELS env var before installing):
#   setx OLLAMA_MODELS "%CD%\models\ollama"
#
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
MODEL_NAME=qwen2.5:3b

# For OpenRouter (uncomment and fill):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-your-key-here
# MODEL_NAME=openai/gpt-4o-mini

# --- Document Chunking ---
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# --- Retrieval ---
# TOP_K=20        # documents retrieved before reranking
# TOP_N=5         # documents kept after reranking
# MAX_CONTEXT_CHARS=12000

# --- Min characters for a chunk to be indexed ---
# MIN_CHUNK_CHARS=20

# --- Conversation memory ---
# MEMORY_SIZE=5   # number of user/assistant turns kept per session

# --- Server ---
# HOST=0.0.0.0
# PORT=8000

# --- CORS (comma-separated) ---
# CORS_ORIGINS=http://localhost:8501

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_FORMAT=text   # or "json" for structured logs

# --- Oracle database (client/contract data) ---
# Required for login and personal analytics. HAYETT_USER is the source of
# truth: the backend verifies its schema READ-ONLY and never creates, alters
# or drops tables. Typical local setup (Oracle 23ai FREE):
# ORACLE_DSN=localhost:1521/FREEPDB1
# ORACLE_USER=hayett_user
# ORACLE_PASSWORD=your_password
# Optional fallback parts (used only when ORACLE_DSN is empty):
# ORACLE_HOST=localhost
# ORACLE_PORT=1521
# ORACLE_SERVICE=FREEPDB1
# Seeding (schema + sample clients) is OPT-IN and never runs by default.
# Set SEED_DB_ON_START=1 ONLY against an empty database you own to create
# ahmed@gmail.com / fatma@gmail.com again. Never against the existing base.
# SEED_DB_ON_START=1

# --- Email (creation compte client) ---
# SMTP standard (stdlib). Laisser vide pour désactiver l'envoi d'email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=1
# SMTP_TIMEOUT=10

# --- Authentication ---
# How long a login stays bound to a browser session (seconds).
# AUTH_TTL_SECONDS=43200
