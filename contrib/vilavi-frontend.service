[Unit]
Description=Vilavi Chatbot — Streamlit Frontend
After=network.target vilavi-backend.service
Wants=vilavi-backend.service

[Service]
Type=simple
User=vilavi
WorkingDirectory=/opt/vilavi/frontend_streamlit
Environment=API_URL=http://127.0.0.1:8000
ExecStart=/opt/vilavi/frontend_streamlit/venv/bin/streamlit run app.py --server.port=8501 --server.address=0.0.0.0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
