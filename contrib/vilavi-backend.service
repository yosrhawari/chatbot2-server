[Unit]
Description=Vilavi Chatbot — FastAPI Backend
After=network.target

[Service]
Type=simple
User=vilavi
WorkingDirectory=/opt/vilavi/backend
EnvironmentFile=-/opt/vilavi/backend/.env
ExecStart=/opt/vilavi/backend/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
